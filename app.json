{
  "expo": {
    "name": "SalaryBox FacePass",
    "slug": "salarybox-facepass",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "salarybox-facepass",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0066FF"
    },
    "android": {
      "package": "com.salarybox.facepass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0066FF"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salarybox.facepass",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SalaryBox FacePass to access the camera for face recognition.",
        "NSLocationWhenInUseUsageDescription": "Allow SalaryBox FacePass to access your location for attendance verification."
      }
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SalaryBox FacePass to access your location for attendance verification."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SalaryBox FacePass to access the camera for face recognition."
        }
      ]
    ],
    "owner": "bamacharanchhandogi",
    "extra": {
      "eas": {
        "projectId": "4b6f2660-1277-40bb-9166-e882c2a4eeb5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b6f2660-1277-40bb-9166-e882c2a4eeb5"
    }
  }
}
